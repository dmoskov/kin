# Server environment variables for the family tree app.
# Copy to /home/<user>/family-tree/.env on your server and fill in values.
# Lines starting with # are comments and are ignored.

# ── Required ──────────────────────────────────────────────────────────────

# Flask session secret — generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-long-random-string

# ── Database (pick one) ───────────────────────────────────────────────────

# SQLite (default — no setup needed, good for personal use)
# FAMILY_TREE_DB=/home/ec2-user/family-tree/data/family.db

# PostgreSQL (better for multi-user or heavy load)
# DATABASE_URL=postgresql://user:password@localhost:5432/familytree

# PostgreSQL on RDS with IAM auth (recommended — no database password anywhere).
# Leave the password out and the app mints a short-lived RDS IAM token per
# connection using the EC2 instance role. One-time setup: deploy/db-iam-setup.sql
# plus an rds-db:connect grant on the instance role (see README).
# DATABASE_URL=postgresql://familytree_app@familytree-db.xxxx.us-east-1.rds.amazonaws.com:5432/familytree?sslmode=require

# ── Auth & access control ─────────────────────────────────────────────────

# Google OAuth client ID — enables Google Sign-In
# Get one at https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Set Authorised JavaScript origin to your domain, redirect URI not required.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of Gmail addresses that can edit the tree.
# Anyone not listed can view but not make changes.
# If unset, editing is unrestricted (fine if the app is private/access-controlled).
# EDITORS=you@gmail.com,partner@gmail.com

# Person ID of the tree admin (can assign emails to other tree members).
# This is the `id` field from your person record in the database.
# ADMIN_PERSON_ID=your-person-id

# ── AI document parsing ───────────────────────────────────────────────────

# Anthropic API key — enables "Parse with AI" for uploaded documents.
# Get one at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Photo storage ─────────────────────────────────────────────────────────

# S3 bucket name — stores photos in S3 instead of local disk.
# Recommended for production so photos survive server replacements.
# Bucket must exist; the app uses IAM role credentials automatically on EC2.
# S3_BUCKET=your-bucket-name

# ── Tuning ────────────────────────────────────────────────────────────────

# MAX_PHOTO_BYTES=8388608    # 8 MB per photo upload (default)
# MAX_DOC_BYTES=15728640     # 15 MB per document upload (default)
